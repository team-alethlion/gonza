{
  "version": 2,
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/backend-service"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend-service/api/$1" },
    { "source": "/admin/(.*)", "destination": "/backend-service/admin/$1" }
  ]
}
